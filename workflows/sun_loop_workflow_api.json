{
  "1": {
    "class_type": "UNETLoader",
    "_meta": {"title": "Load Wan 2.1 Fun-InP 14B (trained for end-frame conditioning - no flash)"},
    "inputs": {"unet_name": "Wan2.1-Fun-InP-14B_fp8_e4m3fn.safetensors", "weight_dtype": "default"}
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {"title": "Load umt5 text encoder"},
    "inputs": {"clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default"}
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {"title": "Load Wan VAE"},
    "inputs": {"vae_name": "wan_2.1_vae.safetensors"}
  },
  "4": {
    "class_type": "CLIPVisionLoader",
    "_meta": {"title": "Load CLIP Vision"},
    "inputs": {"clip_name": "clip_vision_h.safetensors"}
  },
  "5": {
    "class_type": "LoadImage",
    "_meta": {"title": "Source image (start AND end frame)"},
    "inputs": {"image": "z-image_00084_.png"}
  },
  "6": {
    "class_type": "CLIPVisionEncode",
    "_meta": {"title": "CLIP Vision encode"},
    "inputs": {"clip_vision": ["4", 0], "image": ["5", 0], "crop": "none"}
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Positive prompt"},
    "inputs": {
      "text": "A woman in flowing white embroidered robes sits in serene meditation in deep space, holding a blazing miniature sun floating above her open palm. The sun's plasma flames swirl, flicker and curl continuously, fiery tendrils dancing around the glowing orb. Stars twinkle softly, the galaxy glows gently in the background. Her robe and hair sway very subtly. She remains still and calm. Slow, gentle, cinematic ambient motion, seamless continuous movement.",
      "clip": ["2", 0]
    }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Negative prompt"},
    "inputs": {
      "text": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走",
      "clip": ["2", 0]
    }
  },
  "9": {
    "class_type": "WanFunInpaintToVideo",
    "_meta": {"title": "Fun-InP - same image both ends = perfect loop"},
    "inputs": {
      "positive": ["7", 0], "negative": ["8", 0], "vae": ["3", 0],
      "clip_vision_output": ["6", 0],
      "start_image": ["5", 0], "end_image": ["5", 0],
      "width": 848, "height": 464, "length": 81, "batch_size": 1
    }
  },
  "10": {
    "class_type": "ModelSamplingSD3",
    "_meta": {"title": "Shift"},
    "inputs": {"model": ["1", 0], "shift": 5.0}
  },
  "11": {
    "class_type": "KSampler",
    "_meta": {"title": "KSampler"},
    "inputs": {
      "model": ["10", 0], "positive": ["9", 0], "negative": ["9", 1],
      "latent_image": ["9", 2], "seed": 0, "steps": 30, "cfg": 5.0,
      "sampler_name": "uni_pc", "scheduler": "simple", "denoise": 1.0
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "_meta": {"title": "VAE Decode"},
    "inputs": {"samples": ["11", 0], "vae": ["3", 0]}
  },
  "13": {
    "class_type": "ImageFromBatch",
    "_meta": {"title": "Trim duplicate end frame (no stutter at seam)"},
    "inputs": {"image": ["12", 0], "batch_index": 0, "length": 80}
  },
  "14": {
    "class_type": "CreateVideo",
    "_meta": {"title": "Create video 16fps"},
    "inputs": {"images": ["13", 0], "fps": 16.0}
  },
  "15": {
    "class_type": "SaveVideo",
    "_meta": {"title": "Save sun_loop.mp4"},
    "inputs": {"video": ["14", 0], "filename_prefix": "sun_loop", "format": "mp4", "codec": "h264"}
  }
}
